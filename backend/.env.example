# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edustack

# JWT
JWT_SECRET=edustack-super-secret-jwt-key-2026-change-in-production
JWT_EXPIRES_IN=24h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Super Admin (override these in production — DO NOT use defaults on public repos)
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=change-this-in-production

# AWS S3 (for direct file uploads to S3 via pre-signed URLs)
# Create an IAM user with s3:PutObject / s3:GetObject on your bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=edustack-storage
# Optional: CloudFront domain for public CDN URLs (faster than direct S3)
AWS_S3_PUBLIC_DOMAIN=

# AI — Gemini is used first if GEMINI_API_KEY is set (faster), else NVIDIA NIM.
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA NIM fallback (OpenAI-compatible). Get a free API key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
